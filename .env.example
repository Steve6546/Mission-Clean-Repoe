# Discord Developer Portal
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://YOUR-DOMAIN/api/auth/discord/callback

# Frontend URL (used to redirect after OAuth login)
FRONTEND_URL=https://YOUR-DOMAIN

# Comma-separated list of allowed CORS origins (e.g. http://localhost:5173)
CORS_ORIGINS=http://localhost:5173

# Secret used to encrypt at-rest Discord credentials persisted via the
# admin Settings form (Dual-Config method 2). Use a 32+ byte base64 value
# in production, e.g.:  openssl rand -base64 32
APP_SECRETS_KEY=

# NOTE: The bot requires the Guild Members privileged intent enabled in the
# Discord Developer Portal (Bot -> Privileged Gateway Intents) for the
# welcome/onboarding features to work.

# Local-only dev bypass for the admin bot endpoints (GET/POST /api/discord/bots,
# activate, delete). Set to "true" ONLY for local dev without an OAuth session.
# MUST stay unset in production — every request is then verified against a real
# Discord OAuth session.
LOCAL_ADMIN_UNSAFE=

# Managed by Replit in the hosted environment
DATABASE_URL=
SESSION_SECRET=
